/* генератор идеи сайта */
const PL=[['#6c5ce7','#00c2b8'],['#e17055','#fdcb6e'],['#00b894','#0984e3'],['#e84393','#6c5ce7']];
const HT=['{n}: качество, которому доверяют','{n}: просто, быстро, честно','Всё о нише «{n}» в одном месте','{n} с гарантией и честной ценой'];
function gen(){const n=$('#gi').value.trim();if(!n)return toast('Введите нишу');let h=0;for(const c of n)h+=c.charCodeAt(0);const p=PL[h%4],t=esc(HT[h%4].replace('{n}',n[0].toUpperCase()+n.slice(1)));
$('#go').innerHTML='<div style="border:1px solid var(--bd);border-radius:14px;overflow:hidden"><div style="padding:30px 18px;text-align:center;color:#fff;background:linear-gradient(135deg,'+p[0]+','+p[1]+')"><h3 style="margin:0 0 12px">'+t+'</h3><span style="background:#fff;color:#111;border-radius:10px;padding:8px 14px;font-weight:700">Оставить заявку</span></div></div><p class="mu">Блоки: '+['Преимущества','Цены','Отзывы','Квиз','Калькулятор','Чат-бот','Карта','FAQ'].filter((_,i)=>(h+i)%3).join(' · ')+'</p><button class="b" id="gw">Хочу такой сайт</button>';
$('#gw').onclick=()=>wa('Хочу сайт для ниши: '+n);burst()}
$('#gb').onclick=gen;$('#gi').onkeydown=e=>{if(e.key==='Enter')gen()};

/* игра «поймай заявку» */
let gsn=0,gtm=0,gint,gsp;
$('#gst').onclick=()=>{clearInterval(gint);clearInterval(gsp);gsn=0;gtm=15;$('#gs').textContent=0;$('#gt').textContent=15;$('#gm').innerHTML='';
gsp=setInterval(()=>{const b=document.createElement('button');b.className='ld';b.textContent='📩';b.style.left=Math.random()*85+'%';b.style.top=Math.random()*80+'%';b.onclick=()=>{b.remove();$('#gs').textContent=++gsn};$('#gm').append(b);setTimeout(()=>b.remove(),1100)},550);
gint=setInterval(()=>{$('#gt').textContent=--gtm;if(gtm<=0){clearInterval(gint);clearInterval(gsp);$('#gm').innerHTML='';toast('Поймано заявок: '+gsn+'. Бот не пропустит ни одной!');burst()}},1000)};

/* халяль-чек */
function hc(){const v=$('#hk').value.trim();if(!v)return toast('Опишите бизнес');const bad=/алког|пиво|пива|водк|виски|коньяк|казино|ставк|букмек|азарт|лотере|свинин|(^|[^а-я])вин[оау]($|[^а-я])/i.test(v);$('#hr').textContent=bad?'❌ С такой тематикой не работаю: это не халяль.':'✅ Халяль! Берусь за проект «'+v+'». Пишите в WhatsApp.';if(!bad)burst()}
$('#hb').onclick=hc;$('#hk').onkeydown=e=>{if(e.key==='Enter')hc()};

/* выгода от бота */
const nv=id=>+$(id).value.replace(/\D/g,'')||0;
function roi(){const s=nv('#r1'),p=+$('#r2').value,c=nv('#r3'),m=Math.round(s*p/100);$('#r2v').textContent=p+'%';$('#rm').textContent=fm(m);$('#ry').textContent=fm(m*12-c);$('#rp').textContent=m>0?(c/m).toFixed(1).replace('.',',')+' мес.':'—'}
$$('#why input').forEach(i=>i.oninput=roi);roi();

/* контакты */
$('#ct').onsubmit=e=>{e.preventDefault();wa('Здравствуйте! Меня зовут '+$('#n1').value+'. Нужен: '+$('#s1').value+'. '+$('#m1').value);toast('Открываю WhatsApp…')};
</script>
</body>
</html>
